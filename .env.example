# Brain. auto = Gemini if GEMINI_API_KEY is set, else Ollama.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Drawing conversations only, if Flash cannot see the PDF
GEMINI_DRAWING_MODEL=gemini-3.1-pro

# Ollama (used when LLM_PROVIDER=ollama, or auto with no Gemini key)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Jarvis API
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Local workspace
DATA_DIR=./data
EXPORTS_DIR=./exports

# Research. Google Custom Search is preferred (Programmable Search Engine + API key).
# https://programmablesearchengine.google.com/  and enable "Custom Search API" on the Cloud project.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# Optional extras if Google CSE is empty
TAVILY_API_KEY=
BRAVE_API_KEY=

# Email: local (demo mailbox) or imap
EMAIL_BACKEND=local
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Calendar: local demo unless Google is connected with Calendar scope
CALENDAR_BACKEND=local
TZ=Asia/Kolkata

# Gmail + Drive OAuth (pgeneration.mech@gmail.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_JSON=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback
GOOGLE_ACCOUNT=pgeneration.mech@gmail.com
GEMINI_TASK_TO=pgeneration.mech@gmail.com
HUD_URL=http://localhost:3000
